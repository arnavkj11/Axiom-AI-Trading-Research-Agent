# Neon gives you two connection strings from the project dashboard, as
# plain "postgresql://" URLs. You can paste those as-is — Settings
# normalizes the scheme to "postgresql+psycopg://" automatically — but
# writing it explicitly here is clearer about which driver we use.

# Pooled connection (via PgBouncer) — used by the running FastAPI app.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Direct connection (no PgBouncer) — used by Alembic for migrations.
DIRECT_DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require

# Free key from https://www.alphavantage.co/support/#api-key. Free tier is
# rate-limited (25 requests/day) — the financials endpoint caches fetched
# metrics in Postgres so repeat requests for the same company don't re-hit
# the API. Restated financials only, not point-in-time — see
# app/financials/models.py.
ALPHA_VANTAGE_API_KEY=<key>

# Free key from https://www.voyageai.com — used to embed SEC filing chunks
# for pgvector similarity search. voyage-3 model, 1024 dimensions (see
# app/filings/voyage_client.py — must match filing_chunks.embedding).
VOYAGE_AI_API_KEY=<key>

# Optional — overrides the default identifying User-Agent SEC EDGAR
# requires on every request (see app/core/config.py for the default).
# EDGAR_USER_AGENT=Your Name your-email@example.com

# Optional — Voyage rate-limit tuning. Defaults (5 texts/batch, 25s between
# requests) are safe for a free-trial account with no payment method (3
# RPM / 10K TPM). Once billing is added (Tier 1: 2000 RPM / 8M TPM), raise
# these to speed up ingestion, e.g.:
# VOYAGE_BATCH_SIZE=64
# VOYAGE_MIN_SECONDS_BETWEEN_REQUESTS=1

# Key from https://console.anthropic.com — used by the research agents for
# structured-output tool calls (see app/agents/llm_client.py). Agent
# responses are validated against a Pydantic schema via forced tool use,
# never parsed from prose.
ANTHROPIC_API_KEY=<key>
